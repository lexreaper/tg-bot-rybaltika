# For Docker/PostgreSQL. Copy to .env and change the password.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rybaltika
DB_USER=rybaltika
DB_PASSWORD=change-me-locally
DEMO_MODE=false
# Only for a frontend served on another origin. JSON array, no wildcard.
CORS_ORIGINS=[]
# S3 keys are optional for reading the menu; needed only for uploading images.
# YANDEX_S3_ACCESS_KEY_ID=
# YANDEX_S3_SECRET_KEY=
# YANDEX_S3_BUCKET_NAME=
